# Elysia Configuration
# Copy this file to .env and fill in your values

# === LLM Provider API Keys ===

# Ollama (Local - No API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI (if using directly)
OPENAI_API_KEY=

# === Application Settings ===

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Default Providers
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=128
OLLAMA_PREWARM=true
MAX_CONTEXT_MESSAGES=12
ENABLE_MEMORY=true
MEMORY_DB_PATH=data/elysia_memory.db
MEMORY_MAX_RESULTS=3
MEMORY_MAX_CONTENT_LENGTH=1000
MEMORY_EMBEDDING_PROVIDER=ollama
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBEDDING_TIMEOUT_MS=750
MEMORY_EMBEDDING_PREWARM=true
MEMORY_EMBEDDING_VERSION=nomic-embed-text-v1
MEMORY_ENCRYPTION_KEY=
MEMORY_RETENTION_DAYS=0
ENABLE_PREFERENCE_EXTRACTION=true

DEFAULT_STT_PROVIDER=whisper
DEFAULT_TTS_PROVIDER=piper
WHISPER_BEAM_SIZE=1
VOICE_PREWARM=true
PIPER_MAX_CHARS=320

# === Phase 3 Tools ===
# Blank uses Desktop, Documents, and Downloads under the current Windows user.
TOOLS_FILE_ROOTS=
TOOLS_MAX_RESULTS=20
TOOLS_MAX_FILE_BYTES=1000000
TOOLS_MAX_SUMMARY_CHARS=12000
TOOLS_MAX_DRAFT_CHARS=2000
TOOLS_EXCLUDED_DIRS=.git,node_modules,.venv,venv,__pycache__
REMINDER_DB_PATH=data/elysia_reminders.db
REMINDER_POLL_SECONDS=15
REMINDER_WORKER_ENABLED=true

# === Phase 5 Desktop Automation ===
# Blank uses Desktop, Documents, Downloads, and local data roots.
DESKTOP_SAFE_ROOTS=
DESKTOP_MAX_FILE_BYTES=1000000
DESKTOP_CLIPBOARD_MAX_CHARS=10000
DESKTOP_INPUT_ENABLED=false
# Direct system-setting changes are disabled by default; only allowlisted power plans are supported when enabled.
DESKTOP_SYSTEM_SETTINGS_ENABLED=false
DESKTOP_ACTION_TIMEOUT_SECONDS=5
DESKTOP_ACTIONS_PER_MINUTE=30
DESKTOP_TRASH_PATH=data/elysia_trash

# === Phase 6 Browser Foundation ===
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
# Empty means browser navigation is disabled. Add exact trusted domains explicitly.
BROWSER_ALLOWED_DOMAINS=
BROWSER_ALLOWED_SCHEMES=https
BROWSER_MAX_SESSIONS=3
BROWSER_SESSION_IDLE_SECONDS=300
BROWSER_SESSION_MAX_SECONDS=1800
BROWSER_NAVIGATION_TIMEOUT_SECONDS=15
BROWSER_ACTION_TIMEOUT_SECONDS=10
BROWSER_MAX_TEXT_CHARS=20000
BROWSER_MAX_LINKS=100
BROWSER_MAX_HEADINGS=50
BROWSER_MAX_TABLE_ROWS=100
BROWSER_DOWNLOADS_ENABLED=false
BROWSER_DOWNLOAD_ROOT=data/browser_downloads
BROWSER_MAX_DOWNLOAD_BYTES=10000000
BROWSER_SCREENSHOTS_ENABLED=false
BROWSER_SCREENSHOT_ROOT=data/browser_screenshots
BROWSER_MAX_SCREENSHOT_BYTES=10000000

# === Phase 7 Code Assistant Foundation ===
CODE_ENABLED=true
# Empty means repository analysis is disabled. Add trusted local project roots explicitly.
CODE_REPOSITORY_ROOTS=
CODE_MAX_FILES=5000
CODE_MAX_FILE_BYTES=1000000
CODE_MAX_RESULTS=50
CODE_MAX_SNIPPET_CHARS=600
CODE_EXCLUDED_DIRS=.git,.hg,.svn,node_modules,.venv,venv,__pycache__,dist,build,coverage
CODE_SUPPORTED_EXTENSIONS=.py,.js,.jsx,.ts,.tsx,.java,.c,.h,.cpp,.hpp,.go,.rs,.json,.yaml,.yml,.md,.html,.css,.sql,.sh
CODE_INDEX_CACHE_PATH=data/code_index.json

# === Phase 8 Planning Foundation ===
PLAN_ENABLED=true
PLAN_DB_PATH=data/elysia_plans.db
PLAN_MAX_TASKS=100
PLAN_MAX_GOAL_CHARS=2000
PLAN_MAX_TEXT_CHARS=2000
PLAN_MAX_RETRIES=2
PLAN_DECOMPOSITION_ENABLED=true
PLAN_DECOMPOSITION_TIMEOUT_SECONDS=4
PLAN_MAX_DECOMPOSED_TASKS=12
PLAN_MAX_PARALLEL_TASKS=3

# === Phase 9 Autonomous Agents ===
AGENTS_ENABLED=true
AGENTS_DB_PATH=data/elysia_agents.db
AGENTS_WORKER_ENABLED=true
AGENTS_POLL_SECONDS=30
AGENTS_MIN_INTERVAL_SECONDS=300
AGENTS_MAX_RUNTIME_SECONDS=120
AGENTS_MAX_ACTIVE=3
AGENTS_MAX_TOOL_CALLS_PER_RUN=10
AGENTS_MAX_NOTIFICATIONS_PER_DAY=10

# === Phase 10 Multimodal Input ===
INPUT_ENABLED=true
# Exact local directories accepted for drag-and-drop paths; separate multiple roots with semicolons.
# Example Windows: C:\\Users\\YourName\\Desktop;C:\\Users\\YourName\\Downloads
INPUT_SAFE_ROOTS=
INPUT_ATTACHMENT_DIR=data/attachments
INPUT_MAX_FILES_PER_DROP=10
INPUT_MAX_FILE_BYTES=10000000
INPUT_MAX_TOTAL_BYTES=50000000
INPUT_MAX_ATTACHMENTS=1000
INPUT_RETENTION_HOURS=24
INPUT_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.yaml,.yml,.py,.js,.jsx,.ts,.tsx,.java,.c,.h,.cpp,.hpp,.go,.rs,.pdf,.png,.jpg,.jpeg,.webp,.gif,.wav,.mp3,.m4a,.mp4,.webm
# Text/code attachments are summarized in the background; image/audio/video/PDF processors are future work.
INPUT_PROCESSING_ENABLED=true
INPUT_PROCESSING_AUTO_SUMMARY=true
# Cloud providers are blocked for attachment content unless explicitly enabled.
INPUT_PROCESSING_ALLOW_CLOUD=false
INPUT_PROCESSING_MAX_TEXT_CHARS=12000
INPUT_PROCESSING_MAX_SUMMARY_CHARS=2000
INPUT_PROCESSING_MAX_MEMORY_PROPOSALS=1
INPUT_PROCESSING_POLL_SECONDS=2

# === Phase 11 Cloud Sync Foundation ===
SYNC_ENABLED=true
# Cloud transport is disabled by default; no remote request is made unless explicitly enabled.
SYNC_CLOUD_ENABLED=false
# Generate/store this locally as a Fernet key. Never send it in chat or commit it to source control.
SYNC_ENCRYPTION_KEY=
SYNC_DEVICE_ID=
SYNC_BACKUP_DIR=data/sync_backups
SYNC_DB_PATH=data/elysia_sync.db
SYNC_MAX_BACKUPS=20
SYNC_MAX_PACKAGE_BYTES=100000000
SYNC_CLOUD_ENDPOINT=
# Shared device-to-relay secret; keep only in local .env and rotate on device revocation.
SYNC_AUTH_TOKEN=
# Exact origins separated by semicolons, for example https://sync.example.com
SYNC_ENDPOINT_ALLOWLIST=
SYNC_ALLOW_LOOPBACK_HTTP=false
SYNC_REQUEST_TIMEOUT_SECONDS=15
SYNC_CLOCK_SKEW_SECONDS=300
SYNC_REPLAY_WINDOW_SECONDS=900
SYNC_MAX_PUSH_BYTES=100000000

# Optional self-hosted relay. Keep disabled on ordinary desktop-only installations.
SYNC_RELAY_ENABLED=false
SYNC_RELAY_DB_PATH=data/elysia_sync_relay.db
SYNC_RELAY_STORAGE_DIR=data/sync_relay_packages
# Relay secret must match the enrolled desktop's SYNC_AUTH_TOKEN; never log or commit it.
SYNC_RELAY_SHARED_TOKEN=
# Exact device IDs separated by semicolons; leave empty only for a deliberately isolated development relay.
SYNC_RELAY_ALLOWED_DEVICES=
SYNC_RELAY_MAX_PACKAGE_BYTES=100000000

# === Phase 12 Enterprise Foundation ===
ENTERPRISE_ENABLED=true
ENTERPRISE_DB_PATH=data/elysia_enterprise.db
ENTERPRISE_WORKSPACE_ID=default-workspace
ENTERPRISE_WORKSPACE_NAME=Elysia Local Workspace
# Required to use /api/v1/admin/*; never log or send this token.
ENTERPRISE_ADMIN_TOKEN=
ENTERPRISE_MAX_MEMBERS=100
ENTERPRISE_AUDIT_RETENTION_DAYS=90
ENTERPRISE_ANALYTICS_RETENTION_DAYS=90
# Bootstrap token issues short-lived sessions; keep it only in local .env.
ENTERPRISE_SESSION_TTL_MINUTES=60
# Required for signed bearer sessions; generate and store locally.
ENTERPRISE_SESSION_SIGNING_KEY=
# External SSO stays disabled until a reviewed OIDC/SAML adapter is selected.
ENTERPRISE_SSO_ENABLED=false
ENTERPRISE_SSO_ISSUER=
ENTERPRISE_SSO_CLIENT_ID=
ENTERPRISE_SSO_REDIRECT_URI=
ENTERPRISE_MFA_READINESS_ENABLED=true

# === Advanced Settings ===

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/elysia.log

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# === Phase 3 Local Vision Foundation ===
VISION_ENABLED=true
VISION_MAX_PIXELS=16000000
VISION_OCR_TIMEOUT_SECONDS=20
VISION_MAX_OCR_CHARS=12000

# === Phase 4 Plugin Trust Boundary ===
# Optional SHA-256 fingerprints of trusted Ed25519 public keys, separated by semicolons.
# Unsigned bundled plugins remain local-only; signed packages must match this allowlist.
PLUGIN_TRUSTED_KEY_FINGERPRINTS=

# === Jev ===
# Local data dir for Jev (contacts, notes, OAuth tokens). Default ~/.jev
JEV_DATA_DIR=~/.jev
# Optional free YouTube Data API key — resolves "play X on YouTube" to the exact video
YOUTUBE_API_KEY=
# Google OAuth for Gmail/Calendar: EITHER the client JSON path OR id+secret.
# Create the Desktop-app OAuth client yourself in Google Cloud Console (see README).
JEV_GOOGLE_CLIENT_JSON=
JEV_GOOGLE_CLIENT_ID=
JEV_GOOGLE_CLIENT_SECRET=
# Wake word (hands-free summoning). Off by default — the overlay toggle is the
# explicit opt-in. Model: an openWakeWord model name ("hey_jarvis" works out of
# the box) or a path to a custom .onnx/.tflite, e.g. ~/.jev/wakeword/hey_jev.onnx
JEV_WAKE_ENABLED=false
JEV_WAKE_MODEL=hey_jarvis
JEV_WAKE_THRESHOLD=0.5
JEV_WAKE_COOLDOWN_S=45

# Dictation mode (say it, it types). Hotkey toggles recording anywhere on the
# system; the hotkey is read by the Electron shell at launch, so set it before
# starting the app. Confirm shows the cleaned-text preview before typing.
JEV_DICTATION_HOTKEY=CommandOrControl+Shift+D
JEV_DICTATION_CONFIRM=true

# Agent mode ("say it and it's done" multi-step chaining). The Ollama planner
# decomposes one command into at most JEV_AGENT_MAX_STEPS tool steps, executed
# in order with per-step timeout JEV_AGENT_STEP_TIMEOUT_S.
JEV_AGENT_MAX_STEPS=5
JEV_AGENT_STEP_TIMEOUT_S=60

# Screen-aware mode ("circle anything, then just ask"). The hotkey opens the
# region-select overlay — the ONLY trigger for screen capture (never
# background, never continuous). JEV_SEE_MODEL needs `ollama pull moondream`
# on the machine once. Captures live in memory only and expire after
# JEV_SEE_CAPTURE_TTL_S seconds.
JEV_SEE_HOTKEY=CommandOrControl+Shift+S
JEV_SEE_MODEL=moondream
JEV_SEE_CAPTURE_TTL_S=300

# === Explicit Real-Time Updates ===
# Uses fixed RSS feeds from BBC, CNBC, NYT, Al Jazeera, Bloomberg, Reuters, and MarketWatch.
# Keep disabled unless current-data access is explicitly desired.
REALTIME_DATA_ENABLED=false
REALTIME_DATA_TIMEOUT_SECONDS=8
REALTIME_DATA_MAX_ITEMS=12
