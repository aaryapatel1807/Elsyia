{
  "name": "elysia-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jev — your local voice assistant (Elysia)",
  "author": "Aarya Patel <aaryapatel1807@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:electron",
    "build:vite": "tsc && vite build",
    "build:electron": "tsc && vite build && node scripts/build-electron-main.js",
    "build:backend": "node scripts/build-backend.js",
    "dist": "npm run build:backend && npm run build:electron && electron-builder",
    "dist:dir": "npm run build:backend && npm run build:electron && electron-builder --dir",
    "electron:dev": "concurrently -k \"vite\" \"node scripts/build-electron-main.js --watch\" \"wait-on http://localhost:5173 dist-electron/main.js dist-electron/preload.cjs && electron .\"",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.0.1",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.aaryapatel.jev",
    "productName": "Jev",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "build-resources/icons",
        "to": "icons"
      },
      {
        "from": "../backend/models/wakeword",
        "to": "backend/wakeword"
      }
    ],
    "win": {
      "target": ["nsis", "appx"],
      "icon": "build-resources/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "appx": {
      "identityName": "AaryaPatel.ELSYIA",
      "publisher": "CN=7D2ABDC7-5DC1-4BBE-8123-8BEBA39D2DFE",
      "publisherDisplayName": "Aarya Patel",
      "applicationId": "Elsyia",
      "displayName": "Elsyia",
      "backgroundColor": "#1a1a2e",
      "languages": ["en-US"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jev",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build-resources/icons/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build-resources/icons",
      "category": "Utility",
      "description": "Jev — your local voice assistant"
    }
  }
}
