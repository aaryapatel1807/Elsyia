.installed.cfg
*.egg
MANIFEST
backend/venv/
backend/env/
backend/ENV/
.venv

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
backend/logs/
*.log

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache

# Build output
frontend/dist/
